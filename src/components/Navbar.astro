---
const sections = [
  { id: "about", label: "About" },
  { id: "work", label: "Work" },
  { id: "projects", label: "Projects" },
];
---

<nav>
    <ul>
        {sections.map((section) => (
            <li>
                <a href={`#${section.id}`}>{section.label}</a>
            </li>
        ))}
    </ul>
</nav>