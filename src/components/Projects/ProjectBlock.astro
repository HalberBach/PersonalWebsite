---
const { class: className = "", content, title, image } = Astro.props;
---

<div class={`${className}`}>
  <div class="w-full aspect-square overflow-hidden proj">
    {
      image ? (
        <img src={image} alt={title} class="h-full w-full object-cover" />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-sm text-slate-300">
          No image found
        </div>
      )
    }
  </div>
  <div class="mt-6">
    <h1 class="font-manrope font-semibold text-3xl">{title}</h1>
    <p class="font-manrope mt-2">
      {content}
    </p>
  </div>
</div>

<style>
  .proj {
    background-color: var(--secondary);
  }
</style>
