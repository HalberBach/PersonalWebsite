---
import PageLayout from "../../layouts/PageLayout.astro";
import ProjectBlock from "./ProjectBlock.astro";
import tagesschauImage from "../../assets/newstranslator_icon.png?url";
import ytBlockerImage from "../../assets/yt_blocker_icon.png?url";

const project_entries = [
  {
    title: "Personal Website",
    content:
      "Build this Website using the Astro Framework and Svelte. Besides Figma there has, of course, also been a good use of AI when designing this project. Especially Googles Stitch was very helpful when building the first concepts and details.",
  },
  {
    title: "NewsTranslator",
    image: tagesschauImage,
    content:
      "A personal app I created to translate news articles of the german public News Channel 'Tagesschau' into different languages, for learning purposes. In my case it was supposed to integrate danish into my daily life. Simple app developed with React Native via Expo.",
  },
  {
    title: "YTBlocker",
    image: ytBlockerImage,
    content:
      "A Browser Extension to block shorts completely and sets a time limit for youtube. Allows to Black- or Whitelist certain channels permanently. Also allows to finish a youtube video before blocking youtube.",
  },
];
---

<section {...Astro.props}>
  <PageLayout title="Projects">
    <div
      class="project-grid mx-auto w-full max-w-[120rem] grid grid-cos-1 lg:grid-cols-2 py-20 px-16 gap-x-24 gap-y-32"
    >
      {
        project_entries.map((entry) => (
          <ProjectBlock
            title={entry.title}
            content={entry.content}
            image={entry.image}
            class="project-card px-12"
          />
        ))
      }
    </div>
  </PageLayout>
</section>

<script is:inline type="module">
  if (typeof window !== "undefined") {
    window.addEventListener("load", () => {
      const grid = document.querySelector(".project-grid");
      if (!grid) return;

      const cards = Array.from(grid.querySelectorAll(".project-card"));
      if (!cards.length) return;

      cards.forEach((card) => {
        card.addEventListener("mouseenter", () => {
          cards.forEach((other) => {
            other.classList.toggle("hovered", other === card);
          });
          grid.classList.add("has-hover");
        });

        card.addEventListener("mouseleave", () => {
          grid.classList.remove("has-hover");
          cards.forEach((other) => other.classList.remove("hovered"));
        });
      });
    });
  }
</script>

<style>
  :global(.project-grid.has-hover .project-card:not(.hovered)) {
    transform: scale(0.98);
    filter: brightness(0.9) saturate(0.85);
    opacity: 0.5;
  }

  :global(.project-card) {
    transition:
      transform 250ms ease,
      filter 250ms ease,
      opacity 250ms ease;
    transform: scale(1);
    filter: none;
    opacity: 1;
    will-change: transform, opacity, filter;
  }

  :global(.project-card.hovered) {
    transform: scale(1.02);
    filter: none;
    opacity: 1;
    z-index: 10;
  }
</style>
