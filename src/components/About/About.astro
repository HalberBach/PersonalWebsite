---
import PageLayout from "../../layouts/PageLayout.astro";
import BasicButton from "../../components/Utilities/BasicButton.astro";
import profileImage from "../../assets/profile.png?url";
---

<section {...Astro.props}>
  <PageLayout title="About me">
    <div class="flex flex-col w-full items-center gap-20">
      <div class="grid w-full grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-1
        flex
        justify-center">
          <img src={profileImage} alt="Profile Photo" class="w-70 h-70" />
        </div>
        <div
          class="lg:col-span-2 flex flex-col gap-8 font-manrope tracking-wide"
        >
          <h1 class="text-3xl font-bold">Hey, I am Nils</h1>
          <p class="text-sm md:text-lg max-w-xl">
            I am a 21yo software engineer passionate about creating innovative
            solutions for you. I am always eager to learn about new technologies
            and topics, therefore I'm always looking for new challenges. I have
            3 years of experience in software development, especially backend
            services.
          </p>
          <p class="text-sm md:text-lg max-w-xl">
            Another fact about me ist that I am also very passionate about
            environmental issues and sustainability, which is why I am always
            open to support projects that aim to make a positive impact on the
            environment 🌲. I believe that technology can play a crucial role in
            addressing these challenges.
          </p>
        </div>
      </div>
    </div>
  </PageLayout>
</section>
