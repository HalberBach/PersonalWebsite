---
import PageLayout from "../../layouts/PageLayout.astro";
import TimelineContainer from "./TimelineContainer.astro";

const timelineEntries = [
  {
    left: {
      year: "2023 - 2026",
      title: "FH Aachen",
      subtitle: "University of Applied Sciences",
      description:
        "Dual Degree B.Sc. Applied Mathematics & Computer Science | MATSE Certification",
    },
    right: {
      year: "2023 - 2026",
      title: "BarmeniaGothaer",
      subtitle: "Dual Study Work Partner",
      description:
        "Practical Experience in Software Development within the Insurance Context",
    },
  },
  {
    left: {
      year: "AUG 2026 - NOW",
      title: "IT University of Copenhagen",
      subtitle: "MSc in Computer SciencE",
      description: "MSc in Computer Science???",
    },
  },
];
---

<section {...Astro.props}>
  <PageLayout title="Work">
    <div class="relative w-full">
      <!-- Vertical line -->
      <div
        class="absolute left-1/2 top-0 bottom-0 w-px timeline-line-color -translate-x-1/2"
      >
      </div>

      <div class="flex flex-col gap-16">
        {
          timelineEntries.map((entry) => (
            <TimelineContainer left={entry.left} right={entry.right} />
          ))
        }
      </div>
    </div>
  </PageLayout>
</section>

<style>
  .timeline-line-color {
    background-color: color-mix(in srgb, var(--primary) 15%, transparent);
  }
</style>
