---
import PageLayout from "../../layouts/PageLayout.astro";
import TimelineContainer from "./TimelineContainer.astro";

const timelineEntries = [
  {
    left: {
      year: "2023 - 2026",
      title: "FH Aachen",
      subtitle: "University of Applied Sciences",
      description:
        "Dual Degree B.Sc. Applied Mathematics & Computer Science | MATSE Certification",
    },
    right: {
      year: "2023 - 2026",
      title: "BarmeniaGothaer",
      subtitle: "Dual Study Work Partner",
      description:
        "Practical Experience in Software Development within the Insurance Context",
    },
  },
  {
    left: {
      year: "AUG 2026 - NOW",
      title: "IT University of Copenhagen",
      subtitle: "MSc in Computer SciencE",
      description: "Specializing in ...",
    },
  },
];
---

<section {...Astro.props}>
  <PageLayout title="Work">
    <div class="relative w-full">
      <!-- Vertical line -->
      <div
        class="absolute left-1/2 top-0 h-[180%] w-px -translate-x-1/2 -translate-y-1/2"
      >
        <div
          id="timeline-line"
          class="timeline-line-color timeline-line h-full w-full"
        >
        </div>
      </div>

      <div class="flex flex-col gap-16">
        {
          timelineEntries.map((entry) => (
            <TimelineContainer left={entry.left} right={entry.right} />
          ))
        }
      </div>

      <div class="relative flex flex-col items-center mt-16">
        <div
          class="absolute left-1/2 z-10 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rotate-45 bg-primary"
        >
        </div>

        <div
          class="flex flex-col items-center bg-primary p-10 md:w-100 sm:w-80 w-70"
        >
          <p class="text-9xl font-anton uppercase text-secondary">you</p>
          <div class="my-4 h-px w-24 bg-main-light"></div>
          <p class="text-xs uppercase font-bold font-jetbrains text-secondary">
            Solving your problems
          </p>
        </div>
      </div>
    </div>
  </PageLayout>
</section>

<style>
  .timeline-line-color {
    background-color: color-mix(in srgb, var(--primary) 15%, transparent);
  }

  .timeline-line {
    transform-origin: top center;
    transform: scaleY(var(--line-progress, 0));
    will-change: transform;
    transition: transform 0.1s linear; /* glättet die rAF-Schritte minimal */
  }
</style>

<script>
  const line = document.getElementById("timeline-line");
  const container = line?.closest(".relative.w-full") as HTMLElement | null;

  function clamp(v: number, min: number, max: number) {
    return Math.min(max, Math.max(min, v));
  }

  function updateProgress() {
    if (!line || !container) return;

    const rect = container.getBoundingClientRect();
    const vh = window.innerHeight;

    const start = vh;
    const end = vh * 0.2;

    const progress = clamp((start - rect.top) / (start - end), 0, 1);
    line.style.setProperty("--line-progress", progress.toString());
  }

  let ticking = false;
  // Throttling to prevent to many calls
  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(() => {
        updateProgress();
        ticking = false;
      });
      ticking = true;
    }
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  updateProgress();
</script>
