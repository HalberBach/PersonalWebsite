---
import PageLayout from "../../layouts/PageLayout.astro";
import WorkEndBox from "./WorkEndBox.astro";
import TimelineContainer from "./WorkTimelineContainer.astro";

const timelineEntries = [
  {
    year: "2023 - 2026",
    title: "FH Aachen",
    subtitle: "University of Applied Sciences",
    description:
      "Dual Degree B.Sc. Applied Mathematics & Computer Science | MATSE Certification",
  },
  {
    year: "2023 - 2026",
    title: "BarmeniaGothaer",
    subtitle: "Dual Study Work Partner",
    description:
      "Practical Experience in Software Development within the Insurance Context",
  },
  {
    year: "AUG 2026 - NOW",
    title: "IT University of Copenhagen",
    subtitle: "MSc in Computer SciencE",
    description: "",
  },
];
---

<section {...Astro.props}>
  <PageLayout title="Work">
    <div class="relative w-full">
      <!-- Vertical line -->
<!--       <div class="timeline absolute top-0 h-[180%] w-px">
        <div
          id="timeline-line"
          class="timeline-line-color timeline-line h-full w-full"
        >
        </div>
      </div> -->

      <div class="flex flex-col gap-8 md:gap-16">
        {
          timelineEntries
            .filter((_, index) => index % 2 === 0)
            .map((entry, index) => {
              const nextEntry = timelineEntries[index * 2 + 1];

              return <TimelineContainer left={entry} right={nextEntry} />;
            })
        }
      </div>

      <WorkEndBox />
    </div>
  </PageLayout>
</section>

<style>
  .timeline-line-color {
    background-color: color-mix(in srgb, var(--primary) 15%, transparent);
  }

  .timeline-line {
    transform-origin: top center;
    transform: scaleY(var(--line-progress, 0));
    will-change: transform;
    transition: transform 0.1s linear;
  }
</style>

<script>
  const line = document.getElementById("timeline-line");
  const container = line?.closest(".relative.w-full") as HTMLElement | null;

  function clamp(v: number, min: number, max: number) {
    return Math.min(max, Math.max(min, v));
  }

  function updateProgress() {
    if (!line || !container) return;

    const rect = container.getBoundingClientRect();
    const vh = window.innerHeight;

    const start = vh;
    const end = vh * 0.2;

    const progress = clamp((start - rect.top) / (start - end), 0, 1);
    line.style.setProperty("--line-progress", progress.toString());
  }

  let ticking = false;
  // Throttling to prevent to many calls
  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(() => {
        updateProgress();
        ticking = false;
      });
      ticking = true;
    }
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  updateProgress();
</script>

<style>
  .timeline {
    left: 50%;
    transform: translateX(-50%) translateY(-50%);
  }

  @media (max-width: 768px) {
    .timeline {
      left: 1rem;
      transform: translateX(0) translateY(-50%);
    }
  }
</style>
