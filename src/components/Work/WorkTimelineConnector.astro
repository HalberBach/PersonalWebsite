---
const { side = "left", class: className = "" } = Astro.props;

const isRight = side === "right";
---

<div
  class:list={[
    "absolute tl-connector-bg",
    isRight 
      ? "md:block hidden md:left-1/2 md:top-1/2 md:h-px md:w-16 md:ml-2"
      : "md:block hidden md:left-1/2 md:top-1/2 md:h-px md:-translate-x-full md:w-16 md:-ml-2",
    className,
  ]}
>
</div>

<style>
  .tl-connector-bg {
    background-color: color-mix(in srgb, var(--primary) 15%, transparent);
  }
</style>
